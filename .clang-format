# Matched to the existing style in include/ — tweak and re-run as you like.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left

# class body: access specifiers indented one level, members one more (your current layout)
IndentAccessModifiers: true

BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
SpaceAfterTemplateKeyword: false

# constructor init lists with leading commas, one per line (your BaseBuffer ctor style)
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never

RequiresClausePosition: OwnLine
